# Host path for the container's /data mount, holding the SQLite database.
DATA_HOST_DIR=./blindlists-data
# Public origin, e.g. https://oath.example.com. Only needed when the reverse
# proxy cannot pass X-Forwarded-Host and X-Forwarded-Proto.
# APP_URL=
# Extra origins allowed to send mutations, comma separated.
# TRUSTED_ORIGINS=
