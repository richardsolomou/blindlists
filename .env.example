# Host path for the container's /data mount, holding the SQLite database.
DATA_HOST_DIR=./sealed-lists-data

# Shared only by the application and Centrifugo. Generate with:
# openssl rand -hex 32
CENTRIFUGO_API_KEY=

# Centrifugo listens here on the host so the reverse proxy can forward its
# /connection/* routes. It is never exposed directly to the internet.
# CENTRIFUGO_PORT=8000

# Local development with the app outside Compose uses:
# CENTRIFUGO_CONNECT_URL=http://host.docker.internal:3000/api/realtime/connect

# Public origin, e.g. https://sealed-lists.example.com. Only needed when the
# reverse proxy cannot pass X-Forwarded-Host and X-Forwarded-Proto. Links in
# email are built from it.
# APP_URL=

# Signs session cookies. Generated into /data/auth.secret on first boot; set it
# here instead to manage it yourself. Changing it signs everyone out.
# AUTH_SECRET=

# Email. Without SMTP_HOST and EMAIL_FROM the app sends nothing: no address
# confirmation, no password reset, and no word when a game starts or reveals.
# Any provider that speaks SMTP works.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=sealed-lists@example.com

# Sign in with Google. Callback URL: https://your-host/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Discord. Callback URL: https://your-host/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
