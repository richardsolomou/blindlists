# Authorizes the application to publish through Centrifugo's private HTTP API.
# Generate with:
# openssl rand -hex 32
CENTRIFUGO_API_KEY=

# Authenticates Centrifugo's connection proxy calls to the application. Generate
# a separate value with the same command so it grants no publish access.
CENTRIFUGO_PROXY_SECRET=

# Public origin, e.g. https://sealed-lists.example.com. This restricts realtime
# connections, sets the canonical host, and is used for links in email.
APP_URL=

# Signs session cookies. Generated into /data/auth.secret on first boot; set it
# here instead to manage it yourself. Changing it signs everyone out.
# AUTH_SECRET=

# Email. Without SMTP_HOST and EMAIL_FROM the app sends nothing: no address
# confirmation, no password reset, and no word when a game starts or reveals.
# Any provider that speaks SMTP works.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=sealed-lists@example.com

# Sign in with Google. Callback URL: https://your-host/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Discord. Callback URL: https://your-host/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
